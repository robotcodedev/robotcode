{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2022",
    "lib": ["ES7", "DOM", "ES2018", "ES2019", "ES2020", "ES2021", "ES2022"],
    // The tests import the modules of the extension, so both folders are part of the program.
    "rootDir": "..",
    "outDir": "../../out/test",
    "types": ["mocha", "node", "vscode"],
    // the recorded discovery results in fixtures/ are imported as modules
    "resolveJsonModule": true,
    "esModuleInterop": true
  },
  "include": ["."]
}
