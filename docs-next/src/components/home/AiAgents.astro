---
// The home page's AI agent section: what an agent can do with the RobotCode skill, a demo, and a link to the setup
// guide. The abilities follow the modes of the skill (chat-plugins/robotcode/skills/robotcode/SKILL.md).
import { Icon, LinkButton } from "@astrojs/starlight/components";
import type { ComponentProps } from "astro/types";
import AgentDemo from "./AgentDemo.astro";

const ABILITIES: { icon: ComponentProps<typeof Icon>["name"]; title: string; html: string }[] = [
  {
    icon: "pencil",
    title: "Writes tests from your requirements",
    html:
      "Learns the libraries you use, tries keywords and locators live in the REPL, then writes the test and runs " +
      "it.",
  },
  {
    icon: "error",
    title: "Finds out why a test failed",
    html:
      "From the results of the last run, a CI artifact or a colleague's run, without running everything again or " +
      "loading <code>output.xml</code> into the chat.",
  },
  {
    icon: "puzzle",
    title: "Debugs at a real breakpoint",
    html: "Pauses the real run where it fails, reads the call stack and the variables, and tries keywords right there.",
  },
  {
    icon: "list-format",
    title: "Knows your project",
    html:
      "Which tests, tasks, tags and suites exist, and which tests cover a requirement, resolved the way Robot " +
      "Framework does instead of by grepping files.",
  },
  {
    icon: "open-book",
    title: "Explains libraries and keywords",
    html: "From the versions installed in your environment, including your own resources and Python libraries.",
  },
  {
    icon: "rocket",
    title: "Runs exactly what you ask for",
    html: "A single test, a tag or a suite, with the profile for staging, CI or another browser.",
  },
  {
    icon: "approve-check-circle",
    title: "Keeps the code clean",
    html:
      "Finds unknown keywords, wrong arguments, unresolved variables and unused code before anything runs, and " +
      "fixes them.",
  },
  {
    icon: "analytics",
    title: "Compares runs",
    html: "What fails for the first time, what passes again, and statistics by tag or suite.",
  },
  {
    icon: "setting",
    title: "Sets up your configuration",
    html:
      "Profiles, variables and paths in <code>robot.toml</code>, written from each setting's documentation and " +
      "checked against the effective configuration.",
  },
];
const AGENTS = ["GitHub Copilot", "Claude Code", "Codex", "Open Plugins agents"];
---

<section class="rc-band rc-ai not-content" aria-labelledby="ai-agents">
  <div class="rc-ai-grid">
    <div class="rc-ai-copy">
      <h2 id="ai-agents">Turn your AI agent into a Robot Framework engineer</h2>
      <p class="rc-lead">
        The RobotCode skill teaches your agent to work through your project's own <code>robotcode</code> CLI — so it
        sees your tests, keywords and results the way Robot Framework resolves them, with the profiles of your
        project's <code>robot.toml</code>, instead of guessing from files. For tests and RPA tasks alike.
      </p>
      <div class="rc-agents">
        <span>Works with</span>
        <ul>
          {AGENTS.map((agent) => <li class="rc-chip">{agent}</li>)}
        </ul>
      </div>
      <div class="rc-ai-actions">
        <LinkButton href="/guides/ai-agents/" icon="right-arrow">Set up your agent</LinkButton>
      </div>
    </div>
    <AgentDemo />
  </div>
  <ul class="rc-abilities">
    {
      ABILITIES.map(({ icon, title, html }) => (
        <li>
          <Icon name={icon} size="1.25rem" class="rc-ability-icon" />
          <strong>{title}</strong>
          <span set:html={html} />
        </li>
      ))
    }
  </ul>
</section>

<style>
  .rc-ai-grid {
    display: grid;
    gap: 2.5rem;
    align-items: center;
  }

  @media (min-width: 60rem) {
    .rc-ai-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .rc-ai h2 {
    margin: 0 0 1rem;
    font-size: clamp(var(--sl-text-2xl), calc(1rem + 2vw), var(--sl-text-4xl));
    line-height: 1.15;
    color: var(--sl-color-white);
  }

  .rc-ai code {
    font-family: var(--__sl-font-mono);
    font-size: 0.9em;
  }

  .rc-abilities {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(17rem, 1fr));
    gap: 1.75rem 2rem;
    margin: 3.5rem 0 0;
    padding: 0;
    list-style: none;
  }

  .rc-abilities li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.3rem 0.85rem;
    align-content: start;
  }

  .rc-abilities :global(.rc-ability-icon) {
    grid-row: span 2;
    padding: 0.45rem;
    border-radius: 0.5rem;
    background: var(--sl-color-accent-low);
    color: var(--sl-color-accent-high);
    box-sizing: content-box;
  }

  .rc-abilities strong {
    color: var(--sl-color-white);
  }

  .rc-abilities span {
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-sm);
  }

  .rc-abilities :global(code) {
    font-family: var(--__sl-font-mono);
    font-size: 0.9em;
  }

  .rc-agents {
    margin-top: 1.75rem !important;
  }

  .rc-agents,
  .rc-agents ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: center;
    margin: 0;
    padding: 0;
    list-style: none;
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-sm);
  }

  .rc-chip {
    padding: 0.2rem 0.65rem;
    border: 1px solid var(--rc-line-accent);
    border-radius: 999px;
    background: var(--rc-surface);
    color: var(--sl-color-white);
  }

  .rc-ai-actions {
    margin-top: 2rem;
  }
</style>
