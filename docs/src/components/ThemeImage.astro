---
// A screenshot taken in VS Code's light and in its dark theme: the page shows the variant of the site's current theme,
// also after the reader switches it. Starlight's utility classes hide the other variant; the images load lazily, so a
// hidden variant is not fetched. The captures are made at device scale 2, so a variant is shown at half its pixel size.
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

interface Props {
  light: ImageMetadata;
  dark: ImageMetadata;
  alt: string;
  /** Numbered markers in percent of the image's width and height; the list below the picture explains them. */
  markers?: { x: number; y: number }[];
  /** Opens the variant's original file on click, for screenshots of the whole window. */
  full?: boolean;
}

const { light, dark, alt, markers, full = false } = Astro.props;
const variants = [
  { image: light, hide: "dark:sl-hidden" },
  { image: dark, hide: "light:sl-hidden" },
];
---

<figure class="theme-image">
  {
    variants.map(({ image, hide }) => (
      <div class:list={["variant", hide]}>
        {full ? (
          <a href={image.src} title="Open in full size">
            <Image src={image} alt={alt} width={Math.round(image.width / 2)} densities={[1, 2]} />
          </a>
        ) : (
          <Image src={image} alt={alt} width={Math.round(image.width / 2)} densities={[1, 2]} />
        )}
        {markers && (
          <ol class="markers" aria-hidden="true">
            {markers.map(({ x, y }, index) => (
              <li style={`left: ${x}%; top: ${y}%`}>{index + 1}</li>
            ))}
          </ol>
        )}
      </div>
    ))
  }
</figure>

<style>
  .variant {
    position: relative;
    width: fit-content;
    max-width: 100%;
  }
  .variant img {
    display: block;
    border-radius: 0.5rem;
    box-shadow: var(--sl-shadow-md);
  }
  .markers {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .markers li {
    position: absolute;
    margin: 0;
    transform: translate(-50%, -50%);
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: var(--sl-color-accent);
    color: var(--sl-color-black);
    font-size: var(--sl-text-xs);
    font-weight: 700;
    box-shadow:
      0 0 0 2px var(--sl-color-white),
      var(--sl-shadow-sm);
    pointer-events: none;
  }
</style>
