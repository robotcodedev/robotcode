---
// Starlight's ThemeProvider, plus the seasons of the site: before the page is painted, its inline script decides
// whether it is the Halloween season (October 20 to November 2 by the visitor's date, or `?season=halloween` to
// preview it) and marks it with `data-season` on <html>. In the season it shows the pumpkin favicon, keeps the
// decorations off when the visitor turned "Spooky mode" off (`data-spooky="off"`), and starts in the dark theme unless
// the visitor picked the light or the dark theme. The site is only built at a release, so this is decided in the
// browser. ThemeSelect.astro resolves Auto the same way.
import { Icon } from "@astrojs/starlight/components";
---

{/* Inlined to avoid a flash of the wrong theme. */}
<script is:inline>
  window.StarlightThemeProvider = (() => {
    const root = document.documentElement;
    const today = new Date();
    const month = today.getMonth();
    const day = today.getDate();
    const inSeason =
      (month === 9 && day >= 20) ||
      (month === 10 && day <= 2) ||
      new URLSearchParams(location.search).get("season") === "halloween";
    const read = (key) => {
      try {
        return localStorage.getItem(key);
      } catch {
        return null;
      }
    };
    const storedTheme = read("starlight-theme");
    if (inSeason) {
      root.dataset.season = "halloween";
      if (read("robotcode-spooky") === "off") root.dataset.spooky = "off";
      for (const link of document.querySelectorAll('link[rel~="icon"]')) {
        link.href = "/halloween-favicon.svg";
        link.type = "image/svg+xml";
      }
    }
    const theme =
      storedTheme || (inSeason ? "dark" : matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark");
    root.dataset.theme = theme === "light" ? "light" : "dark";
    return {
      updatePickers(theme = storedTheme || "auto") {
        document.querySelectorAll("starlight-theme-select").forEach((picker) => {
          const select = picker.querySelector("select");
          if (select) select.value = theme;
          /** @type {HTMLTemplateElement | null} */
          const tmpl = document.querySelector(`#theme-icons`);
          const newIcon = tmpl && tmpl.content.querySelector("." + theme);
          if (newIcon) {
            const oldIcon = picker.querySelector("svg.label-icon");
            if (oldIcon) {
              oldIcon.replaceChildren(...newIcon.cloneNode(true).childNodes);
            }
          }
        });
      },
    };
  })();
</script>

<template id="theme-icons">
  <Icon name="sun" class="light" />
  <Icon name="moon" class="dark" />
  <Icon name="laptop" class="auto" />
</template>
