---
// The home page gets RobotCode's own hero: the product name, the tagline with a random subline, the actions, a
// pointer to the open-source section and the RobotCode picture gallery (ported from RandomHeroImage.vue and
// RandomTagline.vue of the VitePress theme). Every other page with a hero gets Starlight's.
import { getImage } from "astro:assets";
import { Icon, LinkButton } from "@astrojs/starlight/components";
import Default from "@astrojs/starlight/components/Hero.astro";

// In display order; the files are copied to src/assets/hero/ by scripts/convert.mjs.
const PICTURES = [
  { file: "robotcode-toy-tray.png", alt: "RobotCode figurines on a tray" },
  { file: "robotcode-vintage.png", alt: "Vintage RobotCode poster" },
  { file: "robotcode-vintage-new.png", alt: "New vintage RobotCode artwork" },
  { file: "robotcode-golf.png", alt: "RobotCode playing golf" },
  { file: "robotcode-rock.png", alt: "RobotCode playing rock music" },
  { file: "robotcode-soccer.png", alt: "RobotCode playing soccer" },
  { file: "robotcode-max.png", alt: "Robert Code" },
  { file: "robotcode-playmo.png", alt: "RobotCode Playmobil" },
  { file: "robotcode-rise.png", alt: "Rise of the RobotCode" },
];
// Pictures of the seasons of the site (ThemeProvider.astro) lie in a folder named after the season below
// src/assets/hero/; while a season is active the gallery shows only its pictures, otherwise none of them. A picture
// whose name ends in `_moon` shows a moon of its own, so the decorations leave theirs out while it is shown. Their alt
// texts, by path; a picture without one still shows, with a general alt text.
const SEASON_ALTS: Record<string, string> = {
  "halloween/01_Failien_Alien_1979.png": "Failien: RobotCode on a horror film poster after Alien",
  "halloween/02_Frankensuite_Frankenstein_1931.png": "Frankensuite: RobotCode in a laboratory full of lightning, after Frankenstein",
  "halloween/03_The_Sixth_Suite_Sixth_Sense_1999.png": "The Sixth Suite: RobotCode among ghosts with a book of code, after The Sixth Sense",
  "halloween/04_Ghostdebuggers_Ghostbusters_1984.png": "Ghostdebuggers: RobotCode with a proton pack among glowing bug ghosts, after Ghostbusters",
  "halloween/05_Flaws_II_Jaws_2_1978.png": "Flaws II: RobotCode bursting out of the water, after Jaws 2",
  "halloween/06_The_Flake_The_Fly_1986.png": "The Flake: RobotCode with the wings and legs of a fly, after The Fly",
  "halloween/07_The_Linting_The_Shining_1980.png": "The Linting: RobotCode breaking through a wooden door, after The Shining",
  "halloween/08_Hallowelint_Halloween_1978.png": "Hallowelint: RobotCode with a knife among jack-o'-lanterns, after Halloween",
  "halloween/09_Friday_the_CIteenth_Friday_the_13th_1980_moon.png": "Friday the CIteenth: RobotCode with a machete under a crescent moon, after Friday the 13th",
  "halloween/11_Nosferatest_Nosferatu_1922_moon.png": "Nosferatest: RobotCode as a vampire in the style of a silent film, after Nosferatu (1922)",
  "halloween/12_The_Exorcisuite_The_Exorcist_1973.png": "The Exorcisuite: RobotCode with a debug book under a street lamp, after The Exorcist",
  "halloween/13_Evil_Debug_II_Evil_Dead_II_1987_moon.png": "Evil Debug II: RobotCode with a chainsaw before a cabin in the woods, after Evil Dead II",
  "halloween/14_Army_of_Debugness_Army_of_Darkness_1992_moon.png": "Army of Debugness: RobotCode with a wrench above an army of skeletons, after Army of Darkness",
  "halloween/15_THE_SUITE.png": "The Suite: RobotCode with a red flare in the ice before a monster wearing its face, after The Thing",
  "halloween/16_IT_FAILED.png": "It Failed: RobotCode with a red balloon reaching out over a storm drain, after It",
  "halloween/17_SCREAM_LOG.png":"Scream.log: RobotCode on the phone beside a failed CI run, with Ghostface behind it, after Scream",
  "halloween/18_THE_RERUN.png": "The Rerun: RobotCode crawling out of an old television, after The Ring",
  "halloween/20_GREMLINTS.png": "Gremlints: RobotCode among little gremlins wrecking a laptop, after Gremlins",
  "halloween/22_BUGGLEJUICE_moon.png": "Bugglejuice: RobotCode in a striped suit before a haunted house and the full moon, after Beetlejuice",
  "halloween/26_A_QUIET_PIPELINE.png": "A Quiet Pipeline: RobotCode holding a finger to its mouth before a monster of failed builds, after A Quiet Place",
  "halloween/27_FINAL_ASSERTION.png": "Final Assertion: RobotCode stopping a row of falling CI dominoes, after Final Destination",
  "halloween/28_A_NIGHTMARE_ON_CI_STREET_moon.png": "A Nightmare on CI Street: RobotCode in bed under a claw of error messages, after A Nightmare on Elm Street",
};
const SUBLINES = [
  "Robot Framework testing — same intelligence in your editor, on the command line, and in your CI pipeline. From your first keyword to enterprise scale.",
  "One workflow for the entire Robot Framework lifecycle — write tests in your editor, run them on the command line, ship them through CI.",
  "Robot Framework testing across your editor, command line, and CI — with the same intelligence, the same configuration, from your first keyword to multi-team suites.",
  "Modern Robot Framework tooling that meets you wherever you work — in your editor, on the command line, and in your CI pipeline.",
];

const route = Astro.locals.starlightRoute;
const { data } = route.entry;
const isHome = route.id === "" && Boolean(data.hero);
const { title = data.title, tagline, actions = [] } = data.hero ?? {};

const files = import.meta.glob<{ default: ImageMetadata }>("../assets/hero/**/*.png", { eager: true });
const seasonPictures = Object.keys(files)
  .map((path) => path.slice("../assets/hero/".length))
  .filter((file) => file.includes("/"))
  .sort()
  .map((file) => {
    const season = file.split("/")[0];
    return { file, alt: SEASON_ALTS[file] ?? `RobotCode in the ${season} season`, season };
  });
const pictures = isHome
  ? await Promise.all(
      [...PICTURES, ...seasonPictures].map(async (picture: { file: string; alt: string; season?: string }) => {
        const { file, alt, season } = picture;
        const source = files[`../assets/hero/${file}`]?.default;
        if (!source) throw new Error(`Hero picture src/assets/hero/${file} is missing`);
        const small = await getImage({ src: source, width: 400, densities: [1, 2] });
        const large = await getImage({ src: source, width: 1024 });
        return {
          src: small.src,
          srcset: small.srcSet.attribute,
          width: small.attributes.width,
          height: small.attributes.height,
          large: large.src,
          alt,
          season,
          moon: file.endsWith("_moon.png"),
        };
      }),
    )
  : [];
const first = pictures[0];
// The newest news post, for the badge above the title; missing where the page is rendered outside a request.
const latestPost = isHome ? Astro.locals.starlightBlog?.posts[0] : undefined;
const newsDate = new Intl.DateTimeFormat("en", { dateStyle: "medium" });
---

{
  isHome ? (
    <div class="rc-hero">
      <div class="rc-hero-copy">
        {latestPost && (
          <a class="rc-news-badge" href={latestPost.href}>
            <time class="rc-news-badge-label" datetime={latestPost.createdAt.toISOString()}>
              {newsDate.format(latestPost.createdAt)}
            </time>
            <span class="rc-news-badge-title">{latestPost.entry.data.title}</span>
            <span aria-hidden="true">→</span>
          </a>
        )}
        {latestPost && (
          <script is:inline>
            // A post younger than 30 days pulses; decided in the browser, the page is only built at a release.
            (() => {
              const badge = document.currentScript.previousElementSibling;
              const published = Date.parse(badge.querySelector("time").dateTime);
              if (Date.now() - published < 30 * 24 * 60 * 60 * 1000) badge.dataset.fresh = "";
            })();
          </script>
        )}
        <h1 id="_top" data-page-title>
          {title}
        </h1>
        {tagline && <p class="rc-tagline">{tagline}</p>}
        <p class="rc-subline" data-sublines={JSON.stringify(SUBLINES)}>
          {SUBLINES[0]}
        </p>
        <div class="rc-actions">
          {actions.map(({ attrs: { class: className, ...attrs } = {}, icon, link: href, text, variant }) => (
            <LinkButton {href} {variant} icon={icon?.name} class:list={[className]} {...attrs}>
              {text}
              {icon?.html && <Fragment set:html={icon.html} />}
            </LinkButton>
          ))}
        </div>
        <a class="rc-hero-note" href="#open-source">
          <Icon name="heart" />
          Free and open source, built with the community
        </a>
      </div>
      <rc-hero-gallery data-pictures={JSON.stringify(pictures)}>
        <button type="button" class="rc-nav rc-prev" data-step="-1" aria-label="Show previous image">
          ‹
        </button>
        <button type="button" class="rc-picture" aria-label={`Open image: ${first.alt}`}>
          {/* The picture is chosen while the page is parsed, so that the browser requests only that one, early. During
              a season the gallery holds only its pictures; outside of it, only the usual ones. */}
          <img width={first.width} height={first.height} alt="" fetchpriority="high" draggable="false" />
          <script is:inline>
            (() => {
              const img = document.currentScript.previousElementSibling;
              const gallery = img.closest("rc-hero-gallery");
              // during a season with Spooky mode on only its pictures, if it has any, otherwise only the usual ones; a
              // random one first; all pictures stay at hand, because Spooky mode can switch between them
              const root = document.documentElement;
              const season = root.dataset.spooky === "off" ? undefined : root.dataset.season;
              const all = JSON.parse(gallery.dataset.pictures);
              const own = season ? all.filter((p) => p.season === season) : [];
              const pictures = own.length ? own : all.filter((p) => !p.season);
              const index = Math.floor(Math.random() * pictures.length);
              gallery.dataset.allPictures = gallery.dataset.pictures;
              gallery.dataset.pictures = JSON.stringify(pictures);
              gallery.dataset.index = String(index);
              Object.assign(img, { srcset: pictures[index].srcset, src: pictures[index].src, alt: pictures[index].alt });
              gallery.toggleAttribute("data-picture-moon", pictures[index].moon);
              img.parentElement.setAttribute("aria-label", `Open image: ${pictures[index].alt}`);
            })();
          </script>
          <noscript>
            <img
              src={first.src}
              srcset={first.srcset}
              width={first.width}
              height={first.height}
              alt={first.alt}
              draggable="false"
            />
          </noscript>
        </button>
        <button type="button" class="rc-nav rc-next" data-step="1" aria-label="Show next image">
          ›
        </button>
        <dialog class="rc-lightbox" aria-label={first.alt}>
          <button type="button" class="rc-close" aria-label="Close image">
            ×
          </button>
          <button type="button" class="rc-nav rc-prev" data-step="-1" aria-label="Show previous image">
            ‹
          </button>
          <div class="rc-frame">
            <img src={first.large} alt={first.alt} loading="lazy" decoding="async" draggable="false" />
          </div>
          <button type="button" class="rc-nav rc-next" data-step="1" aria-label="Show next image">
            ›
          </button>
        </dialog>
      </rc-hero-gallery>
    </div>
  ) : (
    <Default>
      <slot />
    </Default>
  )
}

<script>
  type Picture = { src: string; srcset: string; large: string; alt: string; season?: string; moon: boolean };

  const SWIPE_MIN_DISTANCE = 48;
  const SWIPE_INTENT_DISTANCE = 10;
  const SWIPE_DIRECTION_RATIO = 1.35;
  const CLICK_SUPPRESSION_TIMEOUT_MS = 250;
  // The gallery moves on by itself after a while, with a short fade; not with reduced motion.
  const AUTOPLAY_MS = 8000;
  const FADE_MS = 300;
  const reducedMotion = matchMedia("(prefers-reduced-motion: reduce)");

  class RcHeroGallery extends HTMLElement {
    #pictures: Picture[] = [];
    #index = 0;
    #suppressNextClick = false;
    #suppressTimeout: ReturnType<typeof setTimeout> | undefined;
    #swipe: { pointerId: number; startX: number; startY: number; horizontal: boolean } | undefined;
    #autoplay: ReturnType<typeof setTimeout> | undefined;
    #hovered = false;

    connectedCallback() {
      this.#pictures = JSON.parse(this.dataset.pictures ?? "[]");
      const picture = this.querySelector<HTMLButtonElement>(".rc-picture")!;
      const dialog = this.querySelector("dialog")!;

      for (const button of this.querySelectorAll<HTMLButtonElement>("[data-step]")) {
        button.addEventListener("click", (event) => {
          event.stopPropagation();
          this.#show(this.#index + Number(button.dataset.step));
        });
      }
      picture.addEventListener("click", (event) => {
        if (!this.#consumeSuppressedClick(event)) this.#open();
      });
      // A click anywhere outside the picture closes the enlarged view, like the close button.
      dialog.addEventListener("click", (event) => {
        if (!this.#consumeSuppressedClick(event)) dialog.close();
      });
      this.querySelector(".rc-frame")!.addEventListener("click", (event) => event.stopPropagation());
      dialog.addEventListener("keydown", (event) => {
        if (event.key === "ArrowLeft" || event.key === "ArrowRight") {
          event.preventDefault();
          this.#show(this.#index + (event.key === "ArrowLeft" ? -1 : 1));
        }
      });
      dialog.addEventListener("close", () => (document.documentElement.style.overflow = ""));
      for (const element of [picture, this.querySelector<HTMLElement>(".rc-frame")!]) this.#addSwipe(element);

      this.addEventListener("pointerenter", () => (this.#hovered = true));
      this.addEventListener("pointerleave", () => (this.#hovered = false));

      // Spooky mode switches between the pictures of the season and the usual ones (Halloween.astro)
      document.addEventListener("rc-spooky", () => this.#choosePictures());

      // The inline script next to the picture has chosen it already.
      this.#show(Number(this.dataset.index ?? 0));
    }

    // the same choice as the inline script, again: the season's pictures with Spooky mode on, otherwise the usual ones
    #choosePictures() {
      const all: Picture[] = JSON.parse(this.dataset.allPictures ?? "[]");
      const root = document.documentElement;
      const season = root.dataset.spooky === "off" ? undefined : root.dataset.season;
      const own = season ? all.filter((p) => p.season === season) : [];
      this.#pictures = own.length ? own : all.filter((p) => !p.season);
      this.#show(Math.floor(Math.random() * this.#pictures.length));
    }

    #show(index: number) {
      const count = this.#pictures.length;
      if (count === 0) return;
      this.#index = (index + count) % count;
      const { src, srcset, large, alt, moon } = this.#pictures[this.#index];
      // the decorations of a season leave their moon out while the picture shows one of its own
      this.toggleAttribute("data-picture-moon", moon);
      const [small, big] = this.querySelectorAll("img");
      Object.assign(small, { src, srcset, alt });
      Object.assign(big, { src: large, alt });
      this.querySelector(".rc-picture")!.setAttribute("aria-label", `Open image: ${alt}`);
      this.querySelector("dialog")!.setAttribute("aria-label", alt);
      // every change, by hand or by itself, gives the picture the full time
      this.#scheduleAutoplay();
    }

    #scheduleAutoplay() {
      clearTimeout(this.#autoplay);
      if (reducedMotion.matches || this.#pictures.length < 2) return;
      this.#autoplay = setTimeout(() => this.#autoplayStep(), AUTOPLAY_MS);
    }

    // waits while the pointer or the keyboard focus is on the gallery, the enlarged view is open or the tab is hidden;
    // otherwise loads the next picture, fades the current one out and shows the next
    async #autoplayStep() {
      if (reducedMotion.matches) return;
      const busy =
        this.#hovered || this.querySelector(":focus-visible") || this.querySelector("dialog")!.open || document.hidden;
      if (busy) return this.#scheduleAutoplay();
      const { src, srcset } = this.#pictures[(this.#index + 1) % this.#pictures.length];
      const next = Object.assign(new Image(), { srcset, src });
      await next.decode().catch(() => undefined);
      this.toggleAttribute("data-fading", true);
      await new Promise((resolve) => setTimeout(resolve, FADE_MS));
      this.#show(this.#index + 1);
      this.toggleAttribute("data-fading", false);
    }

    #open() {
      this.querySelector("dialog")!.showModal();
      document.documentElement.style.overflow = "hidden";
    }

    #consumeSuppressedClick(event: Event) {
      if (!this.#suppressNextClick) return false;
      event.preventDefault();
      event.stopPropagation();
      this.#suppressNextClick = false;
      return true;
    }

    #suppressClickOnce() {
      this.#suppressNextClick = true;
      clearTimeout(this.#suppressTimeout);
      this.#suppressTimeout = setTimeout(() => (this.#suppressNextClick = false), CLICK_SUPPRESSION_TIMEOUT_MS);
    }

    #addSwipe(element: HTMLElement) {
      element.addEventListener("pointerdown", (event) => {
        if (!event.isPrimary || (event.pointerType === "mouse" && event.button !== 0)) return;
        this.#swipe = { pointerId: event.pointerId, startX: event.clientX, startY: event.clientY, horizontal: false };
        element.setPointerCapture?.(event.pointerId);
      });
      element.addEventListener("pointermove", (event) => {
        const swipe = this.#swipe;
        if (!swipe || event.pointerId !== swipe.pointerId) return;
        const dx = event.clientX - swipe.startX;
        const dy = event.clientY - swipe.startY;
        if (!swipe.horizontal && Math.abs(dx) >= SWIPE_INTENT_DISTANCE && Math.abs(dx) > Math.abs(dy) * SWIPE_DIRECTION_RATIO) {
          swipe.horizontal = true;
        }
        if (swipe.horizontal) event.preventDefault();
      });
      element.addEventListener("pointerup", (event) => {
        const swipe = this.#swipe;
        if (!swipe || event.pointerId !== swipe.pointerId) return;
        this.#swipe = undefined;
        if (element.hasPointerCapture?.(event.pointerId)) element.releasePointerCapture(event.pointerId);
        const dx = event.clientX - swipe.startX;
        const dy = event.clientY - swipe.startY;
        if (Math.abs(dx) < SWIPE_MIN_DISTANCE || Math.abs(dx) <= Math.abs(dy) * SWIPE_DIRECTION_RATIO) return;
        event.preventDefault();
        event.stopPropagation();
        this.#suppressClickOnce();
        this.#show(this.#index + (dx > 0 ? -1 : 1));
      });
      element.addEventListener("pointercancel", (event) => {
        if (this.#swipe?.pointerId !== event.pointerId) return;
        this.#swipe = undefined;
        if (element.hasPointerCapture?.(event.pointerId)) element.releasePointerCapture(event.pointerId);
      });
    }
  }
  customElements.define("rc-hero-gallery", RcHeroGallery);

  for (const subline of document.querySelectorAll<HTMLElement>(".rc-subline[data-sublines]")) {
    const sublines: string[] = JSON.parse(subline.dataset.sublines ?? "[]");
    if (sublines.length) subline.textContent = sublines[Math.floor(Math.random() * sublines.length)];
  }
</script>

<style is:global>
  rc-hero-gallery {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    padding: 0 2.75rem;
  }

  /* The strong glow of the hero's backdrop, centred behind the picture wherever the layout puts it. */
  rc-hero-gallery::before {
    content: "";
    position: absolute;
    top: 50%;
    left: 50%;
    z-index: -1;
    width: 80rem;
    height: 52rem;
    transform: translate(-50%, -50%);
    background: radial-gradient(closest-side, var(--rc-glow-strong), transparent 70%);
    pointer-events: none;
  }

  rc-hero-gallery .rc-picture {
    display: flex;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: zoom-in;
    line-height: 0;
    touch-action: pan-y;
  }

  /* Without JavaScript the picture inside <noscript> is shown instead. */
  rc-hero-gallery .rc-picture img:not([src]) {
    display: none;
  }

  /* the fade when the gallery moves on by itself */
  rc-hero-gallery .rc-picture {
    transition: opacity 0.3s ease;
  }

  rc-hero-gallery[data-fading] .rc-picture {
    opacity: 0;
  }

  rc-hero-gallery .rc-picture img {
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: 24rem;
    border-radius: 1rem;
    user-select: none;
  }

  rc-hero-gallery .rc-nav {
    position: absolute;
    top: 50%;
    z-index: 2;
    width: 2.4rem;
    height: 2.4rem;
    border: 1px solid var(--sl-color-hairline);
    border-radius: 999px;
    background: var(--sl-color-bg-nav);
    color: var(--sl-color-white);
    font-size: 1.5rem;
    line-height: 1;
    transform: translateY(-50%);
    cursor: pointer;
    transition: opacity 0.2s ease;
  }

  rc-hero-gallery .rc-prev {
    inset-inline-start: 0.25rem;
  }

  rc-hero-gallery .rc-next {
    inset-inline-end: 0.25rem;
  }

  @media (hover: hover) and (pointer: fine) {
    rc-hero-gallery > .rc-nav {
      opacity: 0;
    }

    rc-hero-gallery:hover > .rc-nav,
    rc-hero-gallery:focus-within > .rc-nav {
      opacity: 1;
    }
  }

  rc-hero-gallery .rc-lightbox {
    width: 100vw;
    max-width: none;
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: 1rem;
    border: 0;
    background: rgb(0 0 0 / 90%);
    cursor: zoom-out;
  }

  rc-hero-gallery .rc-lightbox[open] {
    display: grid;
    place-items: center;
  }

  rc-hero-gallery .rc-lightbox::backdrop {
    background: transparent;
  }

  rc-hero-gallery .rc-frame {
    display: flex;
    padding: 0.75rem;
    border: 1px solid var(--sl-color-hairline);
    border-radius: 0.75rem;
    background: var(--sl-color-bg-nav);
    box-shadow: 0 1.25rem 3.5rem rgb(0 0 0 / 60%);
    cursor: default;
    touch-action: pan-y;
  }

  rc-hero-gallery .rc-frame img {
    display: block;
    width: auto;
    height: auto;
    max-width: min(calc(100vw - 5rem), 1400px);
    max-height: calc(100dvh - 5rem);
    border-radius: 0.5rem;
    user-select: none;
  }

  rc-hero-gallery .rc-close {
    position: absolute;
    top: 0.75rem;
    inset-inline-end: 0.75rem;
    width: 2.5rem;
    height: 2.5rem;
    border: 0;
    border-radius: 999px;
    background: rgb(255 255 255 / 92%);
    color: #111;
    font-size: 1.5rem;
    line-height: 1;
    cursor: pointer;
  }

  .rc-hero {
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-columns: 100%;
    gap: 2rem;
    align-items: center;
    padding-block: 1rem 2.5rem;
  }

  /* The hero's backdrop, a soft glow in the accent colour. */
  .rc-hero::before {
    content: "";
    position: absolute;
    inset: -8rem -50vw -6rem;
    z-index: -1;
    background: var(--rc-hero-bg);
    /* Fades out towards the bottom, so the glow has no edge where the page continues. */
    mask-image: linear-gradient(to bottom, #000 55%, transparent);
    pointer-events: none;
  }

  .rc-hero-copy {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    align-items: center;
    text-align: center;
  }

  .rc-hero-copy > * {
    max-width: 42rem;
  }

  .rc-hero h1 {
    margin: 0;
    font-size: clamp(var(--sl-text-4xl), calc(1rem + 6vw), 5rem);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.03em;
    background: var(--rc-title-gradient);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .rc-hero .rc-tagline {
    margin: 0;
    font-size: clamp(var(--sl-text-xl), calc(0.5rem + 2vw), var(--sl-text-3xl));
    font-weight: 600;
    line-height: 1.2;
    color: var(--sl-color-white);
  }

  .rc-hero .rc-subline {
    margin: 0;
    font-size: var(--sl-text-lg);
    color: var(--sl-color-gray-2);
  }

