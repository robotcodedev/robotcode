// How long each terminal step takes to appear, and how long a terminal session stays after its last step, in seconds.
const STEP_DELAY = 1;
const HOLD = 4;

const duration = (panel: Panel) =>
  panel.kind === "terminal"
    ? panel.steps.length * STEP_DELAY + HOLD
    : panel.kind === "series"
      ? panel.slides.reduce((sum, slide) => sum + slideSeconds(panel, slide), 0)
      : panel.duration;
type Series = Extract<Panel, { kind: "series" }>;
const slideSeconds = (panel: Series, slide: Slide) => ("video" in slide ? slide.duration : (panel.seconds ?? 0));
// A series that shows each feature in several editors sets its dots apart by feature.
const grouped = (panel: Series) => new Set(panel.slides.map(({ label }) => label)).size < panel.slides.length;
// A slide's window title names the editor and what it shows; the slide's dot carries the same name.
const slideTitle = (slide: Slide) => `${slide.editor} · ${slide.label}`;
const title = (panel: Panel) => (panel.kind === "series" ? slideTitle(panel.slides[0]) : panel.title);

// Colours the section headers, keys and strings of the TOML file shown.
const toml = (line: string) =>
  line
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/("[^"]*")/g, '<span class="rc-toml-string">$1</span>')
    .replace(/^(\[[^\]]+\])$/, '<span class="rc-toml-section">$1</span>')
    .replace(/^([\w-]+)(?= =)/, '<span class="rc-toml-key">$1</span>');
---

<rc-demo class="rc-tour not-content" style={`--step-delay: ${STEP_DELAY}s`}>
  <ol class="rc-tour-list">
    {
      FEATURES.map(({ icon, title, html, links, panel }, index) => (
        <li class="rc-tour-item">
          <button
            type="button"
            data-demo-tab
            aria-pressed={index === 0 ? "true" : "false"}
            style={`--duration: ${duration(panel)}s`}
          >
            <Icon name={icon} class="rc-tour-icon" />
            <span>{title}</span>
            <span class="rc-demo-progress" aria-hidden="true" />
          </button>
          <div class="rc-tour-body">
            <p set:html={html} />
            <p class="rc-tour-links">
              {links.map(([text, href], i) => (
                <>
                  {i > 0 && " · "}
                  <a href={href}>{text}</a>
                </>
              ))}
            </p>
          </div>
        </li>
      ))
    }
  </ol>

  <figure class="rc-window rc-tour-window" data-llms-skip>
    <div class="rc-window-bar">
      <span class="rc-window-dots" aria-hidden="true"><i></i><i></i><i></i></span>
      <span class="rc-window-title" data-demo-title>{title(FEATURES[0].panel)}</span>
      <PauseButton />
    </div>
    <div class="rc-demo-panels">
      {
        FEATURES.map(({ title: name, panel }, index) => (
          <div
            class:list={["rc-tour-panel", `rc-tour-${panel.kind}`, { "is-active": index === 0 }]}
            data-demo-panel
            data-title={title(panel)}
            aria-label={name}
          >
            {panel.kind === "video" ? (
              <button type="button" class="rc-tour-shot" aria-label={`Enlarge: ${panel.label}`}>
                <video src={panel.src} width="2072" height="1182" muted loop playsinline preload="metadata" />
              </button>
            ) : panel.kind === "series" ? (
              <>
                <div class="rc-tour-slides">
                  {panel.slides.map((slide, slideIndex) => (
                    <button
                      type="button"
                      class:list={["rc-tour-shot", { "is-current": slideIndex === 0 }]}
                      data-demo-slide
                      data-title={slideTitle(slide)}
                      data-slide-seconds={slideSeconds(panel, slide)}
                      aria-label={`Enlarge: ${slide.alt}`}
                    >
                      {"video" in slide ? (
                        <video src={slide.video} width="2072" height="1182" muted loop playsinline preload="metadata" />
                      ) : (
                        <Image
                          src={slide.image}
                          alt={slide.alt}
                          widths={[1036, slide.image.width]}
                          sizes="(min-width: 60rem) 38rem, 100vw"
                        />
                      )}
                    </button>
                  ))}
                </div>
                <div class="rc-tour-slide-tabs">
                  {panel.slides.map((slide, slideIndex) => (
                    <button
                      type="button"
                      class:list={{
                        "is-group-start":
                          grouped(panel) && slideIndex > 0 && slide.label !== panel.slides[slideIndex - 1].label,
                      }}
                      data-demo-slide-tab
                      aria-pressed={slideIndex === 0 ? "true" : "false"}
                      aria-label={slideTitle(slide)}
                      title={slideTitle(slide)}
                    ></button>
                  ))}
                </div>
              </>
            ) : (
              <ol class="rc-term">
                {panel.steps.map((step, stepIndex) => (
                  <li class="rc-step" style={`--i: ${stepIndex}`}>
                    {step.kind === "file" ? (
                      <div class="rc-term-file">
                        <span class="rc-term-filename">{step.name}</span>
                        <pre set:html={step.content.map(toml).join("\n")} />
                      </div>
                    ) : (
                      <>
                        <div class="rc-term-command">
                          <span class="rc-term-prompt">{step.prompt ?? "$"}</span>
                          <code>{step.command}</code>
                        </div>
                        {step.output && <pre>{step.output.join("\n")}</pre>}
                      </>
                    )}
                  </li>
                ))}
              </ol>
            )}
          </div>
        ))
      }
    </div>
  </figure>
  <dialog class="rc-tour-lightbox" aria-label="Enlarged view">
    <img alt="" hidden />
    <video muted loop playsinline hidden></video>
  </dialog>
</rc-demo>

<script>
  import "./demo-player";

  // A picture or recording opens enlarged, a recording where it is; a click anywhere or Escape closes it. The demo
  // holds while it is open.
  for (const tour of document.querySelectorAll(".rc-tour")) {
    const dialog = tour.querySelector<HTMLDialogElement>(".rc-tour-lightbox")!;
    const largeImage = dialog.querySelector("img")!;
    const largeVideo = dialog.querySelector("video")!;
    for (const shot of tour.querySelectorAll<HTMLButtonElement>(".rc-tour-shot")) {
      shot.addEventListener("click", () => {
        const image = shot.querySelector("img");
        const video = shot.querySelector("video");
        largeImage.hidden = !image;
        largeVideo.hidden = !video;
        if (image) Object.assign(largeImage, { src: image.currentSrc || image.src, alt: image.alt });
        if (video) {
          largeVideo.src = video.currentSrc || video.src;
          largeVideo.currentTime = video.currentTime;
          void largeVideo.play().catch(() => {});
        }
        dialog.showModal();
        tour.classList.add("is-holding");
      });
    }
    dialog.addEventListener("click", () => dialog.close());
    dialog.addEventListener("close", () => {
      largeVideo.pause();
      tour.classList.remove("is-holding");
    });
  }
</script>

<style>
  .rc-tour {
    display: grid;
    gap: 2rem;
    align-items: start;
  }

  @media (min-width: 60rem) {
    .rc-tour {
      grid-template-columns: 5fr 7fr;
      gap: 2.5rem;
    }
  }

  /* On narrow screens the window comes first, so it stays next to the list of features. */
  .rc-tour-window {
    order: -1;
    min-width: 0;
  }

  @media (min-width: 60rem) {
    .rc-tour-window {
      order: 0;
    }
  }

  .rc-tour-list {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .rc-tour-item {
    position: relative;
    overflow: hidden;
    border: 1px solid var(--sl-color-hairline);
    border-radius: 0.75rem;
    background: var(--rc-surface);
    transition: border-color 0.2s ease;
  }

  .rc-tour-item:has([aria-pressed="true"]) {
    border-color: var(--rc-line-accent);
  }

  .rc-tour-item button {
    display: flex;
    gap: 0.75rem;
    align-items: center;
    width: 100%;
    padding: 0.8rem 1rem;
    border: 0;
    background: transparent;
    color: var(--sl-color-white);
    font: inherit;
    font-weight: 600;
    text-align: start;
    cursor: pointer;
  }

  .rc-tour-item :global(.rc-tour-icon) {
    flex: none;
    padding: 0.35rem;
    border-radius: 0.5rem;
    background: var(--sl-color-accent-low);
    color: var(--sl-color-accent-high);
    box-sizing: content-box;
  }

  .rc-tour-body {
    padding: 0 1rem 1rem 3.65rem;
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-sm);
  }

  .rc-tour-body p {
    margin: 0;
  }

  .rc-tour-body :global(a) {
    color: var(--sl-color-text-accent);
  }

  .rc-tour-body :global(code) {
    font-family: var(--__sl-font-mono);
    font-size: 0.9em;
  }

  .rc-tour-links {
    margin-top: 0.6rem !important;
  }

  /* Once the player runs, only the selected feature shows its text. */
  .is-ready .rc-tour-item:not(:has([aria-pressed="true"])) .rc-tour-body {
    display: none;
  }

  .rc-tour-panel {
    display: flex;
    flex-direction: column;
  }

  /* Screenshots and recordings, all 2072×1182, are shown whole at the width of the window. */
  .rc-tour-shot {
    flex: 1;
    display: grid;
    place-items: center;
    padding: 0;
    border: 0;
    cursor: zoom-in;
  }

  .rc-tour-shot :global(img),
  .rc-tour-shot video {
    display: block;
    width: 100%;
    height: auto;
  }

  .rc-tour-video .rc-tour-shot {
    background: #1e1e1e;
  }

  .rc-tour-lightbox {
    width: 100vw;
    max-width: none;
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: 1rem;
    border: 0;
    background: rgb(0 0 0 / 90%);
    cursor: zoom-out;
  }

  .rc-tour-lightbox[open] {
    display: grid;
    place-items: center;
  }

  .rc-tour-lightbox::backdrop {
    background: transparent;
  }

  .rc-tour-lightbox img,
  .rc-tour-lightbox video {
    max-width: min(calc(100vw - 2rem), 1920px);
    max-height: calc(100dvh - 2rem);
    border-radius: 0.5rem;
    box-shadow: 0 1.25rem 3.5rem rgb(0 0 0 / 60%);
  }

  /* A series of screenshots: all in one grid cell. Only the others are hidden; the current one inherits the visibility
     of its panel, so it stays hidden while another panel is shown. While the demo plays, the current screenshot fades
     in on top of the previous one, which is hidden once it is covered. */
  .rc-tour-slides {
    display: grid;
    flex: 1;
    background: #14161b;
  }

  .rc-tour-slides > .rc-tour-shot {
    grid-area: 1 / 1;
  }

  .rc-tour-slides > .is-current {
    z-index: 1;
  }

  .rc-tour-slides > .rc-tour-shot:not(.is-current) {
    opacity: 0;
    visibility: hidden;
  }

  .is-armed .rc-tour-slides > .is-current {
    transition: opacity 0.6s ease;
  }

  .is-armed .rc-tour-slides > .rc-tour-shot:not(.is-current) {
    transition:
      opacity 0s 0.6s,
      visibility 0s 0.6s;
  }

  /* One dot per slide, a little apart where the next feature starts; the current one is drawn wider. */
  .rc-tour-slide-tabs {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    padding: 0.55rem;
    border-top: 1px solid var(--sl-color-hairline);
  }

  .rc-tour-slide-tabs button {
    display: grid;
    place-items: center;
    width: 1.4rem;
    height: 1.4rem;
    padding: 0;
    border: 0;
    border-radius: 999px;
    background: none;
    cursor: pointer;
  }

  .rc-tour-slide-tabs .is-group-start {
    margin-left: 0.5rem;
  }

  .rc-tour-slide-tabs button::before {
    content: "";
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 999px;
    background: var(--sl-color-gray-5);
    transition:
      width 0.2s,
      background-color 0.2s;
  }

  .rc-tour-slide-tabs button:hover::before {
    background: var(--sl-color-gray-3);
  }

  .rc-tour-slide-tabs button[aria-pressed="true"]::before {
    width: 1.15rem;
    background: var(--sl-color-accent);
  }

  .rc-term {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    margin: 0;
    padding: 1.1rem;
    list-style: none;
    font-family: var(--__sl-font-mono);
    font-size: 0.8rem;
    line-height: 1.55;
  }

  .rc-term pre {
    margin: 0.2rem 0 0;
    padding: 0;
    overflow-x: auto;
    background: transparent;
    color: var(--sl-color-gray-2);
    font: inherit;
  }

  .rc-term-command {
    display: flex;
    gap: 0.6rem;
    min-width: 0;
  }

  .rc-term-command code {
    overflow-x: auto;
