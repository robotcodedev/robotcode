import vscodeCompletion from "../../assets/screenshots/vscode-completion.png";
import vscodeDebug from "../../assets/screenshots/vscode-debug.mp4";
import vscodeDiagnostics from "../../assets/screenshots/vscode-diagnostics.png";
import vscodeHover from "../../assets/screenshots/vscode-hover.png";
import vscodeInlayHints from "../../assets/screenshots/vscode-inlayhints.png";
import vscodeReferences from "../../assets/screenshots/vscode-references.png";
import vscodeRunTests from "../../assets/screenshots/vscode-run-tests.mp4";

type TerminalStep =
  | { kind: "command"; prompt?: string; command: string; output?: string[] }
  | { kind: "file"; name: string; content: string[] };
// A slide of a series: a screenshot, or a 2072×1182 screen recording with its length in seconds.
type Slide = { editor: string; label: string; alt: string } & (
  | { image: ImageMetadata }
  | { video: string; duration: number }
);
type Panel =
  | {
      kind: "series";
      // Slides shown one after another, a screenshot for `seconds`, a recording until it has played once; the
      // window title names the editor and the label of each.
      slides: Slide[];
      seconds?: number;
    }
  | {
      kind: "video";
      title: string;
      // A 2072×1182 screen recording, played from the start whenever its panel is shown.
      src: string;
      label: string;
      // The length of the recording, in seconds: the panel stays until it has played once.
      duration: number;
    }
  | { kind: "terminal"; title: string; steps: TerminalStep[] };

type Feature = {
  icon: ComponentProps<typeof Icon>["name"];
  title: string;
  html: string;
  links: [string, string][];
  panel: Panel;
};

