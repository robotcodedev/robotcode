type TerminalStep =
  | { kind: "command"; prompt?: string; command: string; output?: string[] }
  | { kind: "file"; name: string; content: string[] };
// An example of a feature: a screenshot, a 2072×1182 screen recording with its length in seconds, or a terminal
// session. The window title names the editor (or the terminal) and the label of each.
type Slide = { editor: string; label: string } & (
  | { image: ImageMetadata; alt: string }
  | { video: string; duration: number; alt: string }
  | { terminal: TerminalStep[] }
);

type Feature = {
  icon: ComponentProps<typeof Icon>["name"];
  title: string;
  html: string;
  links: [string, string][];
  // The examples, shown one after another: a screenshot for `seconds`, a recording until it has played once, a
  // terminal session until its steps have appeared and stayed a while.
  slides: Slide[];
  seconds?: number;
};

